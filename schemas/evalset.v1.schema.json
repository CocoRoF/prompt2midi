{
  "$defs": {
    "EvalItem": {
      "additionalProperties": false,
      "properties": {
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "lang": {
          "enum": [
            "ko",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "id",
        "lang",
        "tier",
        "text"
      ],
      "title": "EvalItem",
      "type": "object"
    },
    "Expect": {
      "additionalProperties": false,
      "description": "Answer labels. Only properties the prompt states *in words*. Every field is optional; a metric whose\nlabel is missing is reported as 'na' (not applicable) and left out of its denominator.",
      "properties": {
        "bars": {
          "anyOf": [
            {
              "maximum": 512,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bars"
        },
        "instruments": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "piano",
                  "electric_piano",
                  "organ",
                  "nylon_guitar",
                  "steel_guitar",
                  "upright_bass",
                  "electric_bass",
                  "synth_bass",
                  "violin",
                  "strings",
                  "trumpet",
                  "sax",
                  "flute",
                  "clarinet",
                  "marimba",
                  "synth_lead",
                  "synth_pad",
                  "drums"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruments"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tempo_bpm": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 20,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tempo Bpm"
        },
        "time_signature": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]?/(2|4|8|16)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Signature"
        },
        "tonic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tonic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Expect",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "major",
        "minor",
        "dorian",
        "mixolydian",
        "lydian",
        "phrygian",
        "harmonic_minor"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Tonic": {
      "enum": [
        "C",
        "C#",
        "Db",
        "D",
        "D#",
        "Eb",
        "E",
        "F",
        "F#",
        "Gb",
        "G",
        "G#",
        "Ab",
        "A",
        "A#",
        "Bb",
        "B"
      ],
      "title": "Tonic",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/EvalItem"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Prompts",
      "type": "array"
    },
    "version": {
      "const": "1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "name",
    "prompts"
  ],
  "title": "EvalSet",
  "type": "object"
}
